# --- Claude (optional: without a key every LLM path degrades to the deterministic heuristic) ---
# Anthropic API key. Never commit the real value.
ANTHROPIC_API_KEY=
# Pinned model id used by the classifier, extractor, Vision fallback and LLM-as-judge.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Per-request timeout (seconds) and tenacity attempts for Anthropic calls.
ANTHROPIC_TIMEOUT_S=30
ANTHROPIC_MAX_ATTEMPTS=3
# List prices (USD per million tokens) used to compute cost_usd per request.
PRICE_INPUT_PER_MTOK=3.0
PRICE_OUTPUT_PER_MTOK=15.0

# --- Parsing ---
# Path to the tesseract binary for the OCR path (apt-get install tesseract-ocr).
TESSERACT_CMD=/usr/bin/tesseract
# Pages with fewer extractable characters than this are treated as scanned -> OCR.
OCR_MIN_CHARS_PER_PAGE=20
# Send low-confidence documents to Claude Vision for re-processing (needs the API key).
USE_CLAUDE_VISION_FALLBACK=true
# Use the `unstructured` element partitioner when installed (extra `heavy`); otherwise heuristic.
USE_UNSTRUCTURED=false

# --- Confidence routing thresholds ---
CONFIDENCE_AUTO_APPROVE=0.90
CONFIDENCE_HUMAN_REVIEW=0.70

# --- API limits and security ---
# Comma-separated list of allowed CORS origins. Never "*" in production.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
# slowapi rate limit applied to /api/extract endpoints.
RATE_LIMIT=30/minute
# Maximum accepted PDF size (bytes) and text length (chars); larger inputs return 422.
MAX_PDF_BYTES=10485760
MAX_TEXT_CHARS=200000
# Redact PII (SSN, emails, phones, card numbers) from extracted values and logs.
REDACT_PII=true

# --- Storage (optional; the API works without a database) ---
DATABASE_URL=postgresql://docint:docint_dev@localhost:5432/docint

# --- Observability ---
LOG_LEVEL=INFO
# LangSmith tracing of the LangGraph pipeline; only active when the key is set.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=document-intelligence
LANGCHAIN_TRACING_V2=false
